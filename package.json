{
  "name": "the-robot",
  "version": "0.1.0",
  "description": "The Robot — personal offline-capable agent runtime",
  "type": "module",
  "bin": {
    "the-robot": "./dist/cli/index.js",
    "robot": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "robot": "tsx src/cli/index.ts",
    "test": "node --import tsx --test tests/smoke.test.ts tests/api.smoke.test.ts tests/tools.smoke.test.ts tests/tool_calls.test.ts tests/conversations.test.ts",
    "typecheck": "tsc --noEmit",
    "gui": "node scripts/gui-dev.mjs",
    "gui:build": "npm install --prefix gui && npm run build --prefix gui",
    "gui:install": "npm install --prefix gui",
    "start:gui": "tsx src/server/index.ts --static",
    "desktop": "node scripts/desktop.mjs",
    "app": "ROBOT_DESKTOP_START_API=1 node scripts/desktop.mjs --with-api",
    "postinstall": "npm install --prefix gui --no-fund --no-audit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "cli",
    "mcp",
    "ollama",
    "offline",
    "skills",
    "gui",
    "electron"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phantasyx/the-robot.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
