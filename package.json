{
  "name": "the-robot",
  "version": "0.1.0",
  "description": "The Robot \u2014 personal offline-capable agent runtime",
  "type": "module",
  "bin": {
    "the-robot": "./dist/cli/index.js",
    "robot": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "robot": "tsx src/cli/index.ts",
    "test": "node --import tsx --test tests/smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent",
    "cli",
    "mcp",
    "ollama",
    "offline",
    "skills"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Phantasyx/the-robot.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
