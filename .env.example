# Local / Ollama provider (default for offline use)
ROBOT_PROVIDER=ollama
ROBOT_OLLAMA_HOST=http://127.0.0.1:11434
ROBOT_MODEL=llama3.2

# Approval gates: prompt | auto-approve | deny
ROBOT_APPROVAL_MODE=prompt

# Skills and routines roots (optional overrides)
# ROBOT_SKILLS_DIR=./skills
# ROBOT_ROUTINES_DIR=./routines
